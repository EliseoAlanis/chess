@startuml

package "chess.game" {
    class Game <<(D, lightblue) data class>> {
        + board: Board
        + rules: List<ChessRule>
        + turnManager: TurnManager
        + moveHistory: List<MoveRecord>
        + playMove(origin: Position, destination: Position): Game
        - areAllRulesValid(origin: Position, destination: Position): Boolean
    }


package "chess.board" {
    class Board <<(D, lightblue) data class>> {
        + positions: Map<Position, Piece>
        + size: BoardSize
        + movePiece(origin: Position, destination: Position): Board
        + hasPieceAt(position: Position): Boolean
        + getPieceAt(position: Position): Piece
    }

    class BoardSize <<(D, lightblue) data class>> {
        + columns: Int
        + rows: Int
    }

    interface BoardInitializer {
        + generateInitialPositions(): Map<Position, Piece>
    }

    class ClassicBoardInitializer {
        + generateInitialPositions(): Map<Position, Piece>
        - getWhitePieces(): Map<Position, Piece>
        - getBlackPieces(): Map<Position, Piece>
        - getWhiteBackRank(): Map<Position, Piece>
        - getBlackBackRank(): Map<Position, Piece>
    }
}

package "chess.movement" {
    class Position <<(D, lightblue) data class>> {
        + row: Int
        + col: Int
    }

    class MoveRecord <<(D, lightblue) data class>> {
        + piece: Piece
        + origin: Position
        + destination: Position
    }

    interface Movement {
        + checkTrajectory(origin: Position, destination: Position): Boolean
    }

    class DiagonalMovement
    class StraightMovement
    class LShapeMovement
}

package "chess.rules" {
    interface ChessRule {
        + isValid(board: Board, origin: Position, destination: Position, currentTurn: Color): Boolean
    }

    class PieceMovementRule
    class CorrectTurnRule
    class ClearPathRule
    class BoardLimitsRule
}

package "chess.turn" {
    interface TurnManager {
        + currentTurn: Color
        + advance(): TurnManager
    }

    class StandardTurnManager <<(D, lightblue) data class>> {
        + currentTurn: Color
        + advance(): TurnManager
    }
}

package "chess.pieces" {
    interface Piece {
        + color: Color
        + hasMoved: Boolean
        + canJump: Boolean
        + isValidMovePattern(origin: Position, destination: Position): Boolean
        + copy(hasMoved: Boolean): Piece
    }

    enum Color {
        BLANCO
        NEGRO
    }

    class PieceFactory {
        + {static} createRook(id: String, color: Color): Piece
        + {static} createKnight(id: String, color: Color): Piece
        + {static} createBishop(id: String, color: Color): Piece
        + {static} createQueen(id: String, color: Color): Piece
    }
}

' Relaciones de Game
Game --> Board
Game --> TurnManager
Game o-- ChessRule
Game o-- MoveRecord

' Relaciones de Board
Board --> BoardSize
Board o-- Position
Board o-- Piece

' Relaciones de Inicialización
BoardInitializer <|.. ClassicBoardInitializer
ClassicBoardInitializer ..> Position : crea
ClassicBoardInitializer ..> PieceFactory : usa

' Relaciones de Turnos
TurnManager <|.. StandardTurnManager
TurnManager --> Color

' Relaciones de Reglas
ChessRule <|.. PieceMovementRule
ChessRule <|.. CorrectTurnRule
ChessRule <|.. ClearPathRule
ChessRule <|.. BoardLimitsRule

' Relaciones de Movimiento
Movement <|.. DiagonalMovement
Movement <|.. StraightMovement
Movement <|.. LShapeMovement
MoveRecord --> Position
MoveRecord --> Piece

' Dependencias cruzadas implícitas
Piece --> Color
ChessRule ..> Board : evalúa
ChessRule ..> Position : evalúa
Piece ..> Position : valida

@enduml
